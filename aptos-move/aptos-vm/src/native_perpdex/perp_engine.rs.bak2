/// Drain async queue when exchange is closed.
/// RESOURCE: AsyncMatchingEngine at market
pub fn drain_async_queue(
    market: [u8; 32],
    batch_size: u64,
) -> Result<(), u64> {
    if is_exchange_open() {
        return Err(EDRAIN_ASYNC_QUEUE_WHEN_EXCHANGE_OPENED);
    }
    async_matching_engine::drain_async_queue_for_market(market, batch_size);
    Ok(())
}

/// Initialize a user if new (checks invite-only restrictions).
/// RESOURCE: AccountCreationRestrictions at @decibel_dex
/// RESOURCE: PerpPositions at account
pub fn init_user_if_new(
    account: [u8; 32], // signer
    fee_tracking_addr: [u8; 32],
) -> Result<(), u64> {
    // Check invite-only account creation restrictions
    // In native context, AccountCreationRestrictions resource is checked by dispatch layer.
    // The logic: if invite_only_account_creation is true, require referrer or allow_list membership.
    // This is enforced by the dispatch layer reading the resource.

    // Initialize user position tracking
    perp_positions::init_user_if_new(account, fee_tracking_addr);
    Ok(())
}

