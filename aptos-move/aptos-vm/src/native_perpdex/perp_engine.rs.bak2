Ok(None)
}

/// Process pending withdrawals.
/// RESOURCE: AsyncWithdrawQueueConfig
pub fn process_pending_withdrawals(
    remaining_work_units: &mut u32,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    // Dispatch layer handles pending withdrawal processing
Ok(())
}

/// Deposit to cross margin.
/// RESOURCE: CollateralBalanceSheet, PerpPositions
pub fn deposit_to_cross(
    user: [u8; 32],
    fungible_asset_metadata: [u8; 32],
    fungible_asset_amount: u64,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if fungible_asset_amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    if !accounts_collateral::is_asset_supported(fungible_asset_metadata) {
        return Err(EMETADATA_NOT_SUPPORTED_COLLATERAL);
    }
    perp_positions::assert_user_initialized(user)?;
    accounts_collateral::deposit_to_cross(user, fungible_asset_metadata, fungible_asset_amount)
}

/// Deposit to isolated position collateral.
/// RESOURCE: CollateralBalanceSheet, PerpPositions
pub fn deposit_to_isolated_position_collateral(
    user: [u8; 32], // signer
    market: [u8; 32],
    fungible_asset_metadata: [u8; 32],
    fungible_asset_amount: u64,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if fungible_asset_amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    if fungible_asset_metadata != accounts_collateral::primary_asset_metadata() {
        return Err(EFUNGIBLE_ASSET_METADATA_MISMATCH);
    }
    perp_positions::assert_user_initialized(user)?;
    accounts_collateral::deposit_to_isolated_position_collateral(
        user, market, fungible_asset_metadata, fungible_asset_amount,
    )
}

/// Transfer collateral to/from isolated position.
/// RESOURCE: CollateralBalanceSheet
pub fn transfer_collateral_to_isolated_position(
    user: [u8; 32], // signer
    market: [u8; 32],
    is_deposit: bool,
    metadata: [u8; 32],
    amount: u64,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if metadata != accounts_collateral::primary_asset_metadata() {
        return Err(EFUNGIBLE_ASSET_METADATA_MISMATCH);
    }
    if amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    accounts_collateral::transfer_collateral_to_isolated_position(
        user, market, is_deposit, amount,
    )
}

