// ===================== Error Codes =====================

const EDEX_ALREADY_INITIALIZED: u64 = 1;
const EDEX_DOESNT_EXIST: u64 = 2;
const EDRAIN_ASYNC_QUEUE_WHEN_EXCHANGE_OPENED: u64 = 3;
const EMARKET_HALTED: u64 = 4;
const EINVALID_TP_SL_PARAMETERS: u64 = 5;
const EFUNGIBLE_ASSET_METADATA_MISMATCH: u64 = 6;
const EINVALID_AMOUNT: u64 = 7;
const EMETADATA_NOT_SUPPORTED_COLLATERAL: u64 = 8;
const EINVALID_TP_SL_FOR_REDUCE_ONLY: u64 = 9;
const EMARKET_NOT_DELISTED: u64 = 10;
const EMARGIN_CALL_FEE_EXCEEDS_LEVERAGE_CAP: u64 = 11;
const ENO_POSITION_FOR_TP_SL: u64 = 12;
const EEMPTY_ORDER_ID_LIST: u64 = 13;
const EACCOUNT_WITHOUT_REFERRER_OR_IN_ALLOW_LIST: u64 = 14;
const EINVALID_REDUCE_ONLY_DIRECTION: u64 = 15;
const EPOSTION_NOT_FOUND: u64 = 16;

const MAX_TP_SL_PER_TRIGGER: u32 = 10;

/// All bits set in integer of width required to encode price.
const MAX_I64: u64 = i64::MAX as u64;
const HI_PRICE: u64 = MAX_I64;

