/// Internal helper to update max leverage.
fn set_market_max_leverage_internal(
    _market: [u8; 32],
    _max_leverage: u8,
) {
    // Updates perp_market_config and price_management max leverage
    // Updates account status cache
}

/// Set market max leverage without emitting event.
/// RESOURCE: PerpMarketConfiguration at market
pub fn set_market_max_leverage_without_event(
    market: [u8; 32],
    max_leverage: u8,
) -> Result<(), u64> {
    // Reject if current margin call fee exceeds the new cap
    let current_fee = perp_market_config::get_margin_call_fee_pct_by_addr(market);
    let new_fee_cap = perp_market_config::get_margin_call_fee_cap_by_addr(max_leverage);
    if current_fee > new_fee_cap {
        return Err(EMARGIN_CALL_FEE_EXCEEDS_LEVERAGE_CAP);
    }
    set_market_max_leverage_internal(market, max_leverage);
    Ok(())
}

/// Set market max leverage with event.
/// RESOURCE: PerpMarketConfiguration at market
pub fn set_market_max_leverage(
    market: [u8; 32],
    max_leverage: u8,
) -> Result<(), u64> {
    set_market_max_leverage_without_event(market, max_leverage)?;
    // EVENT: MarketUpdateEvent
    Ok(())
}

