/// Configure user settings for a market (cross/isolated, leverage).
/// RESOURCE: PerpPositions at account
pub fn configure_user_settings_for_market(
    account: [u8; 32], // signer
    market: [u8; 32],
    is_cross: bool,
    user_leverage: u8,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_positions::configure_user_settings_for_market(account, market, is_cross, user_leverage)
}

/// Close a delisted position.
/// RESOURCE: PerpPositions, PerpMarketConfiguration at market
pub fn close_delisted_position(
    address: [u8; 32],
    market: [u8; 32],
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if !perp_market_config::is_market_delisted_by_addr(market) {
        return Err(EMARKET_NOT_DELISTED);
    }
    clearinghouse_perp::close_delisted_position(address, market)
}

