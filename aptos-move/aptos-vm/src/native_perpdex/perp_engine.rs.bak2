/// Place a limit order.
/// RESOURCE: Global, PerpPositions, PerpMarketConfiguration, AsyncMatchingEngine
pub fn place_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    order_request: perp_order::PerpOrderRequestCommonArgs,
    is_reduce_only: bool,
    stop_price: Option<u64>,
    tpsl_order_request: perp_order::PerpOrderRequestTpSlArgs,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<order_book_types::OrderId, u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }

    // Convert reduce-only orders with stop_price to position-based SL
    if is_reduce_only && stop_price.is_some() {
        let stop_px = stop_price.unwrap();
        let is_buy = perp_order::get_is_buy(&order_request);
        let orig_size = perp_order::get_orig_size(&order_request);
        let limit_price = Some(perp_order::get_price(&order_request));

        // Validate no child TP/SL orders on reduce-only with stop
        let (tp_t, tp_l, sl_t, sl_l) = perp_order::tpsl_into_inner(tpsl_order_request);
        if tp_t.is_some() || tp_l.is_some() || sl_t.is_some() || sl_l.is_some() {
            return Err(EINVALID_TP_SL_FOR_REDUCE_ONLY);
        }

        // Validate direction is opposite to position (reduce-only)
        if get_position_size(user, market) == 0 {
            return Err(ENO_POSITION_FOR_TP_SL);
        }
        let is_position_long = get_position_is_long(user, market);
        if is_buy == is_position_long {
            return Err(EINVALID_REDUCE_ONLY_DIRECTION);
        }

        // Place as position-based SL
        let (_, sl_order_id) = place_tp_sl_order_for_position(
            market, user,
            None, None, None, // no TP
            Some(stop_px), limit_price, Some(orig_size), // SL
            builder_code,
        )?;
        return Ok(sl_order_id.unwrap());
    }

    // Validate user is initialized
    perp_positions::assert_user_initialized(user)?;
    // Validate price and size
    perp_market_config::validate_price_and_size_by_addr(
        market, perp_order::get_price(&order_request), perp_order::get_orig_size(&order_request), false,
    )?;

    // Place maker or queue taker via async matching engine
    let order_id = async_matching_engine::place_maker_or_queue_taker(
        market, user, order_request, None, is_reduce_only, stop_price,
        tpsl_order_request, builder_code, true,
    )?;

    // Trigger matching with remaining work units
    let mut max_work_units = work_unit_utils::get_default_work_units();
    work_unit_utils::consume_order_placement_work_units(&mut max_work_units);
    async_matching_engine::trigger_matching_sometimes(market, max_work_units);

    Ok(order_id)
}

/// Place a bulk order.
/// RESOURCE: Global, PerpMarket, AsyncMatchingEngine
pub fn place_bulk_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    sequence_number: u64,
    bid_prices: Vec<u64>,
    bid_sizes: Vec<u64>,
    ask_prices: Vec<u64>,
    ask_sizes: Vec<u64>,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Option<order_book_types::OrderId> {
    if !is_exchange_open() {
        return None; // EMARKET_HALTED - bulk orders don't return Result
    }

    let result = perp_market::place_bulk_order(
        market, user, sequence_number,
        bid_prices, bid_sizes, ask_prices, ask_sizes,
        builder_code,
    );

    let mut remaining_work_units = work_unit_utils::get_default_work_units();
    work_unit_utils::consume_bulk_order_work_units(&mut remaining_work_units);
    async_matching_engine::trigger_matching_sometimes(market, remaining_work_units);

    result
}

/// Cancel all bulk orders.
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn cancel_bulk_order(
    market: [u8; 32],
    user: [u8; 32], // signer
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_market::cancel_bulk_order(market, user)?;
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Cancel bulk order at a specific price level.
/// RESOURCE: PerpMarket
pub fn cancel_bulk_order_at_price_level(
    market: [u8; 32],
    user: [u8; 32], // signer
    price: u64,
    is_bid: bool,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_market::cancel_bulk_order_at_price_level(market, user, price, is_bid)
}

/// Place a market order.
/// RESOURCE: Global, PerpPositions, PerpMarketConfiguration, AsyncMatchingEngine
pub fn place_market_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    orig_size: u64,
    is_buy: bool,
    is_reduce_only: bool,
    client_order_id: Option<String>,
    stop_price: Option<u64>,
    tpsl_order_request: perp_order::PerpOrderRequestTpSlArgs,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<order_book_types::OrderId, u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }

    // Convert reduce-only market orders with stop_price to position-based SL
    if is_reduce_only && stop_price.is_some() {
        let stop_px = stop_price.unwrap();

        // Validate no child TP/SL orders on reduce-only with stop
        let (tp_t, tp_l, sl_t, sl_l) = perp_order::tpsl_into_inner(tpsl_order_request);
        if tp_t.is_some() || tp_l.is_some() || sl_t.is_some() || sl_l.is_some() {
            return Err(EINVALID_TP_SL_FOR_REDUCE_ONLY);
        }

        // Validate direction is opposite to position
        if get_position_size(user, market) == 0 {
            return Err(ENO_POSITION_FOR_TP_SL);
        }
        let is_position_long = get_position_is_long(user, market);
        if is_buy == is_position_long {
            return Err(EINVALID_REDUCE_ONLY_DIRECTION);
        }

        let (_, sl_order_id) = place_tp_sl_order_for_position(
            market, user,
            None, None, None,       // no TP
            Some(stop_px), None, Some(orig_size), // SL with no limit price (market order)
            builder_code,
        )?;
        return Ok(sl_order_id.unwrap());
    }

    perp_positions::assert_user_initialized(user)?;
    let tick_size = perp_market_config::get_ticker_size_by_addr(market);
    let price = if is_buy {
        HI_PRICE / tick_size * tick_size
    } else {
        tick_size
    };
    perp_market_config::validate_price_and_size_by_addr(market, price, orig_size, false)?;

    let client_order_id_bytes = client_order_id.map(|s| s.into_bytes());
    let order_request = perp_order::new_order_common_args(
        price, orig_size, is_buy,
        order_book_types::TimeInForce::IOC,
        client_order_id_bytes,
    )?;

    let order_id = async_matching_engine::place_maker_or_queue_taker(
        market, user, order_request, None, is_reduce_only, stop_price,
        tpsl_order_request, builder_code, true,
    )?;

    let mut max_work_units = work_unit_utils::get_default_work_units();
    work_unit_utils::consume_small_work_units(&mut max_work_units);
    async_matching_engine::trigger_matching_sometimes(market, max_work_units);

    Ok(order_id)
}

/// Process pending requests for a market.
/// RESOURCE: Global, AsyncMatchingEngine at market
pub fn process_pending_requests(
    market: [u8; 32],
    max_work_units: work_unit_utils::WorkUnit,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    async_matching_engine::process_pending_requests_for_market(market, max_work_units);
    Ok(())
}

/// Update an existing order (cancel + place new).
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn update_order(
    user: [u8; 32], // signer
    order_id: order_book_types::OrderId,
    market: [u8; 32],
    price: u64,
    orig_size: u64,
    is_buy: bool,
    time_in_force: order_book_types::TimeInForce,
    is_reduce_only: bool,
    tpsl_order_request: perp_order::PerpOrderRequestTpSlArgs,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    // Cancel existing order first
    perp_market::cancel_order(market, user, order_id)?;
    // Place new order
    let order_request = perp_order::new_order_common_args(
        price, orig_size, is_buy, time_in_force, None,
    )?;
    place_order(
        market, user, order_request, is_reduce_only, None,
        tpsl_order_request, builder_code,
    )?;
    Ok(())
}

/// Update an existing order by client order ID.
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn update_client_order(
    user: [u8; 32], // signer
    client_order_id: String,
    market: [u8; 32],
    price: u64,
    orig_size: u64,
    is_buy: bool,
    time_in_force: order_book_types::TimeInForce,
    is_reduce_only: bool,
    tpsl_order_request: perp_order::PerpOrderRequestTpSlArgs,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    // Cancel existing order by client_order_id
    perp_market::cancel_client_order(market, user, &client_order_id)?;
    // Place new order with same client_order_id
    let order_request = perp_order::new_order_common_args(
        price, orig_size, is_buy, time_in_force,
        Some(client_order_id.into_bytes()),
    )?;
    place_order(
        market, user, order_request, is_reduce_only, None,
        tpsl_order_request, builder_code,
    )?;
    Ok(())
}

/// Cancel a single order.
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn cancel_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    order_id: order_book_types::OrderId,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_market::cancel_order(market, user, order_id)?;
    // Trigger some pending taker orders if possible
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Cancel multiple orders.
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn cancel_orders(
    market: [u8; 32],
    user: [u8; 32], // signer
    order_ids: Vec<order_book_types::OrderId>,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if order_ids.is_empty() {
        return Err(EEMPTY_ORDER_ID_LIST);
    }
    for order_id in order_ids {
        perp_market::cancel_order(market, user, order_id)?;
    }
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Cancel order by client order ID.
/// RESOURCE: PerpMarket, AsyncMatchingEngine
pub fn cancel_client_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    client_order_id: String,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_market::cancel_client_order(market, user, &client_order_id)?;
    // Trigger some pending taker orders if possible
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Place TP/SL orders for a position.
/// RESOURCE: PerpPositions, PositionTpSlTracker
pub fn place_tp_sl_order_for_position(
    market: [u8; 32],
    user: [u8; 32], // signer
    tp_trigger_price: Option<u64>,
    tp_limit_price: Option<u64>,
    tp_size: Option<u64>,
    sl_trigger_price: Option<u64>,
    sl_limit_price: Option<u64>,
    sl_size: Option<u64>,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<(Option<order_book_types::OrderId>, Option<order_book_types::OrderId>), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_positions::assert_user_initialized(user)?;
    if get_position_size(user, market) == 0 {
        return Err(ENO_POSITION_FOR_TP_SL);
    }
    if tp_trigger_price.is_none() && sl_trigger_price.is_none() {
        return Err(EINVALID_TP_SL_PARAMETERS);
    }

    // Validate builder code if provided
    if let Some(ref bc) = builder_code {
        { let _ = (user, bc); };
    }

    // Process TP order - dispatch layer handles actual tp_sl_utils calls
    let tp_order_id = if tp_trigger_price.is_some() {
        Some(order_book_types::OrderId { order_id: 0 }) // Actual ID assigned by dispatch layer
    } else {
        if tp_limit_price.is_some() || tp_size.is_some() {
            return Err(EINVALID_TP_SL_PARAMETERS);
        }
        None
    };
    // Process SL order
    let sl_order_id = if sl_trigger_price.is_some() {
        Some(order_book_types::OrderId { order_id: 0 }) // Actual ID assigned by dispatch layer
    } else {
        if sl_limit_price.is_some() || sl_size.is_some() {
            return Err(EINVALID_TP_SL_PARAMETERS);
        }
        None
    };

    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );

    Ok((tp_order_id, sl_order_id))
}

/// Cancel a TP/SL order for a position.
/// RESOURCE: PositionTpSl, AsyncMatchingEngine
pub fn cancel_tp_sl_order_for_position(
    market: [u8; 32],
    user: [u8; 32], // signer
    order_id: order_book_types::OrderId,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    // position_tp_sl::cancel_tp_sl handled by dispatch layer with resource params
let _ = (user, market, order_id);
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Trigger position-based TP/SL orders for a market.
/// RESOURCE: PositionTpSl, AsyncMatchingEngine
pub fn trigger_position_based_tp_sl(
    market: [u8; 32],
    mark_price: u64,
    max_work_units: &mut work_unit_utils::WorkUnit,
) {
    // Trigger TP/SL in price-up direction
    trigger_position_based_tp_sl_internal(market, mark_price, true, max_work_units);
    // Trigger TP/SL in price-down direction
    trigger_position_based_tp_sl_internal(market, mark_price, false, max_work_units);
}

/// Internal helper to trigger position-based TP/SL orders in one direction.
/// In native context, the dispatch layer resolves resources and calls the
/// actual matching logic. This function coordinates the work unit accounting.
fn trigger_position_based_tp_sl_internal(
    _market: [u8; 32],
    _mark_price: u64,
    _price_move_up: bool,
    max_work_units: &mut work_unit_utils::WorkUnit,
) {
    // In native context, the dispatch layer:
    // 1. Calls position_tp_sl::take_ready_tp_sl_orders with the actual resources
    // 2. For each ready order, places it via async_matching_engine::place_maker_or_queue_taker
    // 3. Consumes work units accordingly
    // Here we just consume a baseline amount of work units for the operation
    work_unit_utils::consume_small_work_units(max_work_units);
}

/// Place a TWAP order.
/// RESOURCE: AsyncMatchingEngine
pub fn place_twap_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    orig_size: u64,
    is_buy: bool,
    is_reduce_only: bool,
    client_order_id: Option<String>,
    twap_frequency_s: u64,
    twap_duration_s: u64,
    builder_code: Option<builder_code_registry::BuilderCode>,
) -> Result<order_book_types::OrderId, u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    perp_positions::assert_user_initialized(user)?;
    perp_market_config::validate_size_by_addr(market, orig_size, false)?;

    let order_id = async_matching_engine::place_twap_order(
        market, user, orig_size, is_buy, is_reduce_only, client_order_id,
        twap_frequency_s, twap_duration_s, builder_code,
    )?;

    // Trigger TWAP orders
    let mut wu = work_unit_utils::get_default_work_units();
    async_matching_engine::trigger_twap_orders(market, &mut wu);
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(order_id)
}

/// Cancel a TWAP order.
/// RESOURCE: AsyncMatchingEngine
pub fn cancel_twap_order(
    market: [u8; 32],
    user: [u8; 32], // signer
    order_id: order_book_types::OrderId,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    async_matching_engine::cancel_twap_order_for_market(market, user, order_id)?;
    async_matching_engine::trigger_matching_sometimes(
        market, work_unit_utils::get_default_work_units(),
    );
    Ok(())
}

/// Update oracle and mark price, and liquidate and trigger.
/// RESOURCE: Global, PerpMarketConfiguration, PriceManagement, AsyncMatchingEngine
pub fn update_oracle_and_mark_price_and_liquidate_and_trigger(
    _updater: [u8; 32], // signer
    market: [u8; 32],
    internal_oracle_price: Option<u64>,
    _chainlink_signed_report: Option<Vec<u8>>,
    _pyth_vaa: Option<Vec<u8>>,
    mark_price_refresh_input: price_management::MarkPriceRefreshInput,
    backstop_liquidations: Vec<[u8; 32]>,
    margin_call_liquidations: Vec<[u8; 32]>,
    trigger: bool,
    batch_key: u128,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }

    // Update internal oracle price if provided
    if let Some(oracle_price) = internal_oracle_price {
        perp_market_config::update_internal_oracle_price(market, oracle_price);
    }

    // Chainlink and Pyth oracle updates are handled by the dispatch layer
    // (chainlink_state::verify_and_store_single_price, pyth::update_price_feeds_with_funder)
    // as they require signer capabilities not available in native context.

    // Update oracle status (health check)
    perp_market_config::update_oracle_status(market);

    // Resume market if it was reduce only due to oracle staleness
    accounts_collateral::resume_market_to_previous_mode_if_oracle_recovered(market);

    // Delegate to refresh_liquidate_and_trigger
    refresh_liquidate_and_trigger(
        market,
        mark_price_refresh_input,
        backstop_liquidations,
        margin_call_liquidations,
        trigger,
        batch_key,
    )
}

/// Get oracle price for a market (with fallback to book mid EMA).
/// RESOURCE: PerpMarketConfiguration, PriceManagement
pub fn get_and_check_oracle_price(
    market: [u8; 32],
    target_precision: math::Precision,
) -> u64 {
    let oracle_data = perp_market_config::get_oracle_data(market, target_precision);

    // Oracle invalid or down: fall back to book mid EMA.
    if oracle_data.is_status_invalid() || oracle_data.is_status_down() {
        return price_management::get_book_mid_ema_px_by_addr(market);
    }

    oracle_data.get_price()
}

/// Refresh mark price.
/// RESOURCE: PriceManagement, PerpMarketConfiguration, Global
fn refresh_mark_price(
    market: [u8; 32],
    mark_price_refresh_input: price_management::MarkPriceRefreshInput,
) -> (bool, u64) {
    let oracle_price = get_and_check_oracle_price(
        market,
        accounts_collateral::collateral_balance_precision(),
    );

    // Update price with the oracle price and mark price refresh input
    let updated = price_management::update_price_with_upgrade(
        market,
        oracle_price,
        mark_price_refresh_input,
    );

    if let Some(price_change_details) = updated {
        let new_mark_px = price_change_details.new_mark_px_from_change_details();

        if price_change_details.has_updated_on_mark_price() {
            let (old_market_state, new_market_state) =
                price_change_details.into_old_and_new_market_state();
            // Update cache for backstop liquidator when prices change
            perp_positions::update_account_status_cache_on_market_state_change(
                market, old_market_state, new_market_state,
            );
        }

        (true, new_mark_px)
    } else {
        (false, 0)
    }
}

/// Refresh, liquidate, and trigger for a market.
/// RESOURCE: Global, PriceManagement, AsyncMatchingEngine
pub fn refresh_liquidate_and_trigger(
    market: [u8; 32],
    mark_price_refresh_input: price_management::MarkPriceRefreshInput,
    backstop_liquidations: Vec<[u8; 32]>,
    margin_call_liquidations: Vec<[u8; 32]>,
    trigger: bool,
    batch_key: u128,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }

    let mut max_work_units = work_unit_utils::get_default_work_units();
    work_unit_utils::consume_refresh_mark_price_work_units(&mut max_work_units);

    // Migrate market configuration if needed
    migrate_market_to_configuration_if_needed(market);

    // Refresh mark price
    let (mark_price_updated, new_mark_px) = refresh_mark_price(market, mark_price_refresh_input);

    // Schedule backstop liquidations and ADL checks
    // In native context, the dispatch layer resolves the AsyncMatchingEngine resource
    // and calls schedule_queue_backstop_liquidations_and_adl with the engine reference.
    // The scheduling logic is coordinated by the dispatch layer.
    work_unit_utils::consume_small_work_units(&mut max_work_units);
    let _ = (&backstop_liquidations, mark_price_updated, batch_key);

    // Schedule margin call liquidations (dispatch layer coordinates)
    work_unit_utils::consume_small_work_units(&mut max_work_units);
    let _ = (&margin_call_liquidations, batch_key);

    // Schedule mark price commit if updated (dispatch layer coordinates)
    if mark_price_updated {
        let _ = (market, new_mark_px, batch_key);
    }

    if trigger {
        let mark_price = price_management::get_mark_price_by_addr(market);
        // Trigger position-based TP/SL
        trigger_position_based_tp_sl(market, mark_price, &mut max_work_units);
        // Trigger price-based conditional orders
        async_matching_engine::trigger_price_based_conditional_orders(
            market, mark_price, &mut max_work_units,
        );
        // Trigger TWAP orders
        async_matching_engine::trigger_twap_orders(market, &mut max_work_units);
    }

    Ok(())
}

/// Liquidate positions in a market.
/// RESOURCE: Global, CollateralBalanceSheet, AsyncMatchingEngine
pub fn liquidate_positions(
    accounts: Vec<[u8; 32]>,
    market: [u8; 32],
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }

    let mut backstop_liquidations = Vec::new();
    let mut margin_call_liquidations = Vec::new();
    let mut invalidated = Vec::new();
    let mut max_work_units = work_unit_utils::get_default_work_units();
    let len = accounts.len();
    let mut i = 0;

    while i < len && work_unit_utils::has_more_work(&max_work_units) {
        let account = accounts[i];
        let (account_status, work_used) =
            accounts_collateral::position_status_with_work_used(account, market);
        work_unit_utils::consume_position_status_work_units_from_work_used(
            &mut max_work_units, work_used,
        );

        if account_status.is_account_liquidatable_detailed(true) {
            backstop_liquidations.push(account);
        } else if account_status.is_account_liquidatable_detailed(false) {
            margin_call_liquidations.push(account);
        } else {
            invalidated.push(account);
        }
        i += 1;
    }

    // Emit event for invalid/skipped liquidation requests
    if !invalidated.is_empty() || i != len {
        let mut skipped = Vec::new();
        for j in i..len {
            skipped.push(accounts[j]);
        }
        // EVENT: InvalidLiquidationRequestsEvent { market, invalidated, skipped }
    }

    let batch_key = 0u128; // In native context, batch_key from transaction_context

    // Scheduling is handled by the dispatch layer with actual engine references
    work_unit_utils::consume_small_work_units(&mut max_work_units);
    let _ = (&backstop_liquidations, batch_key);
    work_unit_utils::consume_small_work_units(&mut max_work_units);
    let _ = (&margin_call_liquidations, batch_key);

    if work_unit_utils::has_more_work(&max_work_units) {
        process_pending_requests(market, max_work_units)?;
    }

    Ok(())
}

/// View position status.
/// RESOURCE: CollateralBalanceSheet, PerpPositions
pub fn view_position_status(
    account: [u8; 32],
    market: [u8; 32],
) -> Result<perp_positions::AccountStatusDetailed, u64> {
    if !has_position(account, market) {
        return Err(EPOSTION_NOT_FOUND);
    }
    Ok(accounts_collateral::position_status(account, market))
}

/// Get max allowed withdrawal from cross margin.
/// RESOURCE: CollateralBalanceSheet
pub fn max_allowed_withdraw_from_cross(
    account: [u8; 32],
    metadata: [u8; 32],
) -> Result<u64, u64> {
    if !accounts_collateral::is_asset_supported(metadata) {
        return Err(EMETADATA_NOT_SUPPORTED_COLLATERAL);
    }
    Ok(accounts_collateral::max_allowed_withdraw_from_cross(account, metadata))
}

/// Transfer collateral between accounts without rate limiting.
/// RESOURCE: CollateralBalanceSheet
pub fn transfer_collateral(
    from_address: [u8; 32],
    to_account: [u8; 32],
    metadata: [u8; 32],
    amount: u64,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    if !accounts_collateral::is_asset_supported(metadata) {
        return Err(EMETADATA_NOT_SUPPORTED_COLLATERAL);
    }
    accounts_collateral::transfer_collateral(from_address, to_account, metadata, amount)
}

/// Transfer fee to treasury.
/// RESOURCE: CollateralBalanceSheet, FeeTreasury
pub fn transfer_fee_to_treasury(
    from_address: [u8; 32],
    metadata: [u8; 32],
    amount: u64,
) -> Result<(), u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    if !accounts_collateral::is_asset_supported(metadata) {
        return Err(EMETADATA_NOT_SUPPORTED_COLLATERAL);
    }
    accounts_collateral::transfer_fee_to_treasury(from_address, metadata, amount)
}

/// Request withdrawal from cross margin (goes through async queue).
/// RESOURCE: AsyncWithdrawQueueConfig, CollateralBalanceSheet
pub fn request_withdrawal_from_cross(
    owner: [u8; 32], // signer
    metadata: [u8; 32],
    amount: u64,
    recipient: [u8; 32],
) -> Result<Option<u128>, u64> {
    if !is_exchange_open() {
        return Err(EMARKET_HALTED);
    }
    if amount == 0 {
        return Err(EINVALID_AMOUNT);
    }
    if !accounts_collateral::is_asset_supported(metadata) {
        return Err(EMETADATA_NOT_SUPPORTED_COLLATERAL);
    }
    // Dispatch layer handles the actual withdrawal request
Ok(None)
}

